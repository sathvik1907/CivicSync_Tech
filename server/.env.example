# Copy to server/.env and replace placeholders locally. Never commit server/.env.
NODE_ENV=development
PORT=9000
CLIENT_URL=http://localhost:5173

# Atlas: use the complete SRV hostname copied from Cluster -> Connect -> Drivers.
MONGODB_URI=mongodb+srv://DB_USERNAME:URL_ENCODED_PASSWORD@FULL_CLUSTER_HOST.mongodb.net/civicsync?retryWrites=true&w=majority

# Generate a unique random value locally (at least 32 characters).
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ISSUER=civicsync.local
JWT_AUDIENCE=civicsync.users
COOKIE_SECURE=false

# Local demo accounts are disabled unless explicitly enabled. Never enable in production.
DEMO_MODE=false
ALLOW_DEMO_SEED=false
DEMO_ACCOUNT_PASSWORD=123456789abc

# Optional Cloudinary configuration for media uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
